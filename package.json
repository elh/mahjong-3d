{
  "name": "concealed-gang",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist",
    "format": "biome format --write .",
    "format:check": "biome check . --linter-enabled=false --assist-enabled=false",
    "good": "bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run test && bun run build",
    "knip": "knip --no-progress",
    "lint": "bun run lint:biome && bun run lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "knip": "^6.12.2",
    "typescript-eslint": "^8.59.2"
  }
}
